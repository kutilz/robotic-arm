/*
 * wifi_secrets.h.example: TEMPLATE kredensial WiFi.
 *
 * Salin file ini menjadi `wifi_secrets.h` (di folder yang sama) lalu isi
 * SSID/password asli. `wifi_secrets.h` di-gitignore, JANGAN commit kredensial
 * asli, repo ini public.
 *
 * Firmware mencoba semua entry berurutan (WiFiMulti memilih yang sinyalnya
 * paling kuat). Gagal semua -> fallback jadi Access Point (lihat AP_* di bawah).
 */
#pragma once

struct WifiPreset {
  const char* ssid;
  const char* pass;
};

// Daftar WiFi yang dikenal (tambah/kurangi bebas).
static const WifiPreset WIFI_PRESETS[] = {
  { "NamaWiFi1", "password1" },
  { "NamaWiFi2", "password2" },
};

// Fallback Access Point bila semua preset gagal: laptop konek ke SSID ini,
// web ke ws://192.168.4.1:81. Password min. 8 karakter (aturan WPA2).
static const char* AP_SSID = "ARMBOT-AP";
static const char* AP_PASS = "armbot123";

// ---- Jalur CLOUD (opsional) --------------------------------------------
// ESP32 tersambung KELUAR ke relay Cloudflare (folder relay/, lihat
// docs/kontrol-jarak-jauh.md), jadi twin di https://... bisa mengendalikan
// lengan dari mana saja. Jalur lokal (:81 dan halaman :80) tetap jalan.
// Hapus/komentari CLOUD_HOST untuk mematikan jalur cloud sepenuhnya.
//
// Supaya ini berguna di luar rumah, tambahkan hotspot HP ke WIFI_PRESETS di
// atas. WiFi kampus yang pakai halaman login (captive portal) tidak bisa
// dilewati ESP32.
//
// #define CLOUD_HOST       "armbot-relay.namamu.workers.dev"   // tanpa https://
// #define CLOUD_ARM_ID     "armbot"                            // = ARM_ID relay
// #define CLOUD_DEVICE_KEY "isi-sama-dengan-secret-DEVICE_KEY-di-relay"
