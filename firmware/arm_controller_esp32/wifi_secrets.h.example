/*
 * wifi_secrets.h.example — TEMPLATE kredensial WiFi.
 *
 * Salin file ini menjadi `wifi_secrets.h` (di folder yang sama) lalu isi
 * SSID/password asli. `wifi_secrets.h` di-gitignore — JANGAN commit kredensial
 * asli, repo ini public.
 *
 * Firmware mencoba semua entry berurutan (WiFiMulti memilih yang sinyalnya
 * paling kuat). Gagal semua -> fallback jadi Access Point (lihat AP_* di bawah).
 */
#pragma once

struct WifiPreset {
  const char* ssid;
  const char* pass;
};

// Daftar WiFi yang dikenal (tambah/kurangi bebas).
static const WifiPreset WIFI_PRESETS[] = {
  { "NamaWiFi1", "password1" },
  { "NamaWiFi2", "password2" },
};

// Fallback Access Point bila semua preset gagal: laptop konek ke SSID ini,
// web ke ws://192.168.4.1:81. Password min. 8 karakter (aturan WPA2).
static const char* AP_SSID = "ARMBOT-AP";
static const char* AP_PASS = "armbot123";
